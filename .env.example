# Copier ce fichier vers `.env` et adapter les valeurs. `.env` n'est jamais versionné.
#
# Deux règles d'écriture (#184) :
# - une valeur qui contient une espace se met entre guillemets : NOM="deux mots" ; sans eux,
#   l'application s'arrête au démarrage en nommant la ligne ;
# - une valeur qui contient $ ou \ (un mot de passe, souvent) se met entre apostrophes :
#   NOM='a$b'. Entre guillemets ou sans rien, « $b » serait remplacé en silence par la variable b.

# Connexion PostgreSQL : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
# Avec docker compose (voir docker-compose.yml), l'utilisateur est `parc` et le mot de passe
# celui de POSTGRES_PASSWORD ci-dessous.
DATABASE_URL=postgres://parc:changez-moi@localhost:5432/gestion_parc_auto

# Mot de passe de la base créée par docker compose (lu par docker-compose.yml uniquement).
POSTGRES_PASSWORD=changez-moi

# Clé qui chiffre le cookie de session. Au moins 64 caractères aléatoires.
# Générer une valeur : `openssl rand -base64 64` ou, sous PowerShell :
# -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
SESSION_SECRET=remplacez-moi-par-une-chaine-aleatoire-d-au-moins-64-caracteres-xxxxxxxxxx

# Dossier où sont stockés les fichiers déposés (seul le chemin est en base). Hors de git.
DOCUMENTS_DIR=./documents

# Port d'écoute du serveur HTTP.
PORT=3000

# Mettre à `true` derrière HTTPS : le cookie de session n'est alors envoyé qu'en HTTPS.
COOKIES_SECURISES=false

# Vue « alertes » : nombre de jours d'anticipation pour les échéances à venir.
ALERTES_HORIZON_JOURS=30

# Vue « alertes » : nombre de kilomètres d'anticipation pour les opérations du plan d'entretien
# (« Vidange dans 800 km »).
ALERTES_HORIZON_KM=1000

# À qui s'adresse cette installation : `entreprise` (par défaut) montre tout ; `particulier`
# masque les affectations et le service des conducteurs. Voir docs/exploitation.md.
PROFIL=entreprise

# RGPD : un conducteur inactif depuis plus de N jours est supprimé par la commande
# `cargo run -- purger-conducteurs`. Voir docs/exploitation.md.
CONSERVATION_CONDUCTEURS_INACTIFS_JOURS=365

# Fuseau horaire de la date du jour (échéances, affectations, relevés) : celui du système. Sur
# un serveur Linux réglé en UTC, décommenter pour avoir la date de Paris. Sans effet sous Windows.
# TZ=Europe/Paris

# Niveau de journalisation (error, warn, info, debug, trace).
RUST_LOG=info,sqlx=warn

# Rappels par courriel (facultatif, #176) : un message par jour, le matin, seulement s'il y a
# quelque chose à dire, envoyé par la sous-commande `envoyer-rappels` lancée par une tâche
# planifiée. Sans COURRIEL_SMTP_HOTE, rien n'est lu et rien n'est envoyé. Voir
# docs/exploitation.md, § 9. Gmail demande un « mot de passe d'application ».
# COURRIEL_SMTP_HOTE=smtp.gmail.com
# Port : 587 avec starttls (par défaut), 465 avec tls.
# COURRIEL_SMTP_PORT=587
# Sécurité : starttls (par défaut), tls, ou aucune (serveur sur la machine même, jamais sur Internet).
# COURRIEL_SMTP_SECURITE=starttls
# Identifiant et mot de passe SMTP, ensemble ou pas du tout.
# COURRIEL_SMTP_IDENTIFIANT=moi@gmail.com
# COURRIEL_SMTP_MOT_DE_PASSE=mot-de-passe-d-application
# COURRIEL_EXPEDITEUR="Autoclair <moi@gmail.com>"
# Facultatif (#182) : des adresses en plus de celles des comptes qui ont demandé le rappel dans
# « Mon compte » (une boîte partagée, par exemple), séparées par des virgules.
# COURRIEL_DESTINATAIRES=parc@exemple.fr
# La base des liens du courriel : l'adresse à laquelle on ouvre l'application.
# COURRIEL_ADRESSE_APPLICATION=https://exemple.fr
